+/**
+ * Builds a "pure" pass-through calendar of the normalized university
+ * timetable events, with no study sessions in it. This is what's served on
+ * `/feeds/school.ics` -- a separate subscription URL from `/feeds/study.ics`
+ * so a calendar app (or a person) can tell classes and study sessions apart,
+ * show/hide them independently, or subscribe to only one of the two.
+ *
+ * This re-renders from the already-parsed `sourceEvents` (not the raw feed
+ * bytes verbatim) so it reflects the same horizon window and recurrence
+ * expansion the scheduler itself used, and stays a well-formed single VCALENDAR
+ * even if the original feed had quirks (missing UIDs, duplicate UIDs, etc)
+ * that the parser already normalized away.
+ */
+export function generateSchoolIcs(
+  sourceEvents: SourceEvent[],
+  config: Config,
+  opts: IcsOutputOptions
+): string {
+  const cal = ical({
+    name: opts.calendarName ?? "School Schedule",
+    timezone: { name: config.timezone, generator: getVtimezoneComponent },
+    prodId: { company: "study-scheduler", product: "study-scheduler", language: "EN" },
+    method: ICalCalendarMethod.PUBLISH,
+  });
+
+  for (const e of sourceEvents) {
+    cal.createEvent({
+      id: `school-${e.canonicalId}@${opts.domain}`,
+      start: new Date(e.startUtc),
+      end: new Date(e.endUtc),
+      timezone: config.timezone,
+      summary: e.summary,
+      location: e.location ?? undefined,
+      description: "Pass-through from your university timetable feed. Generated by study-scheduler.",
+    });
+  }
+
   return cal.toString();
 }
 
