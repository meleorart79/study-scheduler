{
  "name": "study-scheduler",
  "version": "1.0.0",
  "description": "Single-user study session scheduler: university ICS in, study-session ICS out.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@touch4it/ical-timezones": "^1.9.0",
    "better-sqlite3": "^11.3.0",
    "croner": "^8.1.0",
    "fastify": "^5.12.3",
    "ical-generator": "^7.2.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "fast-check": "^3.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^5.0.0"
  }
}
