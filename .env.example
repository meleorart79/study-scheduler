# Copy this to .env and fill in real values. Never commit the real .env.

# Exactly one of these two should be set (STUDY_FEED_FILE wins if both are).
# You can also set sourceFeed.file / sourceFeed.url directly in
# config/default.yaml instead -- these env vars, if set, override the YAML.

# Path to a local .ics file you've exported from your university's system
# (e.g. the whole semester, downloaded once). Read fresh on every
# regeneration; no live/network fetch involved.
STUDY_FEED_FILE=./data/school-schedule.ics

# Your university timetable ICS feed URL (input only; never re-served).
# STUDY_FEED_URL=https://my-university.example/timetable/abc123.ics

# Secret token required as ?token=... on the generated /feeds/study.ics URL.
# Generate one with: openssl rand -hex 24
STUDY_FEED_TOKEN=change-me-to-a-random-string-at-least-16-chars

# Secret token required as "Authorization: Bearer ..." on all /admin/* routes.
# Defaults to STUDY_FEED_TOKEN if not set; recommended to use a separate value.
STUDY_ADMIN_TOKEN=change-me-to-a-different-random-string

# Used to build stable ICS UIDs: study-{id}@STUDY_DOMAIN
STUDY_DOMAIN=study.mydomain.example

# Port the HTTP server listens on (and, under Docker, the host port it's
# published on too -- see docker-compose.yml). Defaults to 3000 if unset.
PORT=3067

LOG_LEVEL=info
